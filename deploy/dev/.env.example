# Copy to .env beside compose.yaml and fill in. .env is git-ignored; never commit it.

# The kernel's public issuer, exactly as its discovery document states it.
KEYCLOAK_ISSUER=https://<the kernel host>/realms/scnehaux

# Generate each with: openssl rand -hex 32
POSTGRES_PASSWORD=
IDENTITY_APP_PASSWORD=

# No client secret goes here: every client of this service authenticates with its own key by
# signed JWT (ADR-IAM-001 §5.12). create-kernel-clients.sh and create-registration-client.sh make the
# keys in ./keys with the kernel's tools, and the kernel is given only their public halves.
#
# The kernel checkout's deploy/dev directory, whose new-client-key.sh and set-client-key.sh make and
# install the keys.
KERNEL_DEPLOY_DIR=/srv/identity-kernel/deploy/dev
#
# The user the service and the ceremony run as, and so the owner of their private keys. The image's
# nonroot user unless you need another.
KEYS_OWNER=65532:65532
#
# IDENTITY_CALLER_KEY_FILE, the development caller's private key that dev-token.ps1 signs with, is
# not set here: `./create-kernel-clients.sh >> .env` appends it (README §First start, step 2), and a
# line here as well would leave it twice. It belongs to the user that runs the scripts.

# The password bootstrap.sh gives the bootstrap Principal, for logging in to obtain a token.
# Development only. Generate with: openssl rand -hex 16
IDENTITY_CALLER_PASSWORD=

# The Go module proxy the images build through. Set GOPROXY=direct where the network intercepts TLS
# to proxy.golang.org; go.sum and the checksum database still verify every module.
# GOPROXY=https://proxy.golang.org,direct

# The loopback port the API is published on. Expose it through the tunnel only if something off
# the server needs to call it; every mutation requires a provider-scope token either way.
IDENTITY_CONTROL_PORT=8082

# The kernel stack's Keycloak container and its bootstrap administrator, used by the setup scripts
# to register this service's clients. Read from the kernel's deploy/dev/.env.
KERNEL_KEYCLOAK_CONTAINER=scnehaux-identity-dev-keycloak-1
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=

# The rollout switches, both report unless set. IDENTITY_UNMANAGED_CLIENTS=disable also disables a
# Keycloak client no registration describes; set it once the bootstrap clients (the BFF and the
# caller) are adopted. IDENTITY_TOKEN_TYPE=enforce refuses a token not typed at+jwt; set it once the
# log no longer reports one. Recreate the service after changing either:
# docker compose up -d identity-control
# IDENTITY_UNMANAGED_CLIENTS=report
# IDENTITY_TOKEN_TYPE=report
#
# Whether the Principal sweep disables a kernel user no mapping accounts for, or only lists it at
# GET /v1/principals:unmapped (TDD-identity-control-001 1.13.0). report on this server unless set.
# IDENTITY_UNMAPPED_USERS=report
#
# compose.yaml runs this server as development (IDENTITY_ENVIRONMENT): non-production, so a
# registration may hold fewer than two owners (production keeps at least two, ADR-IAM-003 §5.1), and
# the one environment that admits the mail catcher below.

# Account security notifications (TDD-identity-control-008 1.7.0 §The Adapter). smtp-catcher runs the
# dispatcher with the development adapter: each request is rendered as a plain message and handed by
# SMTP to the stack's mail catcher, Mailpit, which relays nothing. A proof code is read there, in its web
# interface (README §Reading a code in the mail catcher), as it will be read in an inbox in production.
# The log names a notification's event and recipient count, never an address or a code. standin hands
# each request over and delivers nothing, so no code can be read. Left empty, no dispatcher runs and
# every request waits in requested. The service refuses smtp-catcher unless IDENTITY_ENVIRONMENT is
# development, and standin in production. Recreate the service after changing it:
# docker compose up -d identity-control
IDENTITY_NOTIFICATION_DELIVERY=smtp-catcher
#
# The loopback port of the mail catcher's web interface and API. Reach it through the tunnel, or on the
# server with curl.
# MAILPIT_UI_PORT=8025

# A provider's temporary password for a person created without one (ADR-IAM-010). It lasts 24 hours
# unused, by default and at most, and 1 hour at least; the sweep removes it by then.
# IDENTITY_TEMPORARY_PASSWORD_TTL=24h
# IDENTITY_TEMPORARY_PASSWORD_SWEEP_INTERVAL=5m

# Provider authority from Organization Control (TDD-identity-control-006). Leave both empty until
# organization-control's stack runs on this server; its deploy/dev README says when and what to set.
# IDENTITY_DELIVERY_PRINCIPAL_ID=
# IDENTITY_ORGANIZATION_BASE_URL=http://organization-control:8080
