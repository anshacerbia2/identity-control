# Client private keys made by create-kernel-clients.sh and create-registration-client.sh. They never
# leave the host that made them (ADR-IAM-001 §5.12).
deploy/dev/keys/
*.pem

# A host's own compose settings (deploy/dev/compose.override.example.yaml shows the shape). They hold
# that host's subnets and ports, and never belong in the repository.
deploy/dev/compose.override.yaml

# Coverage profiles are build output. CI produces and uploads them as an artifact, so
# a committed copy is only ever stale.
*.out
coverage
cov-src

# Binaries produced by `go build` without -o.
/identity-control
/identity-migrate

# Atlas writes its own state here when a command is interrupted. The migration
# directory itself IS committed; this is only the lock and scratch output.
.atlas
atlas.sum.tmp

# Editor and OS noise.
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db

# Local development environment. Never committed: it holds this machine's credentials.
.env

# The Makefile's fmt gate writes and removes this; a failed run can leave it.
.fmt.tmp

# scripts/image-scan.sh and scripts/atlas-execute-path.sh work here outside CI: the vulnerability
# database, saved images and traces.
.image-scan/
