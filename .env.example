# Local development environment. Copy to .env, which is gitignored:
#
#   make env
#
# The Makefile loads .env and exports every name in it, so nothing has to be typed and no
# command here is shell-specific. .env is read by make, not by the binary: the service still
# takes its configuration from the process environment alone.
#
# Values carry no surrounding quotes. make passes the rest of the line verbatim, so a quoted
# DSN arrives with its quotes attached and fails as a connection error.

# ---------------------------------------------------------------------------
# What the test suite needs. This is enough for `make test`, `make test-integration`,
# and `make test-ci` -- the whole suite, with no Keycloak.
# ---------------------------------------------------------------------------

# The administrative connection. Integration tests create and drop schema, so this is the
# owner rather than a runtime role. internal/controldb then connects as the runtime role to
# prove it holds no ownership and no DDL.
TEST_DATABASE_URL=postgres://postgres:Scnehaux@localhost:5432/identity_control_dev?sslmode=disable

# Used by the migration stages and by `make test-ci`.
IDENTITY_MIGRATION_DATABASE_URL=postgres://postgres:Scnehaux@localhost:5432/identity_control_dev?sslmode=disable

# ---------------------------------------------------------------------------
# What `make run` needs in addition. Both are unavailable on a machine with no Keycloak,
# so `make run` is not the way to check this service out locally -- `make test-ci` is.
# ---------------------------------------------------------------------------

# The runtime login role, which inherits identity_runtime and owns nothing. Its password is
# not recoverable from the cluster: if it is unknown, reset it as the owner with
#   ALTER ROLE identity_app WITH PASSWORD '<new>';
# and put the same value here. Deliberately not defaulted to the administrative password --
# running the service as the owner would make every ownership assertion pass for the wrong
# reason, which is the failure internal/controldb exists to catch.
IDENTITY_DATABASE_URL=postgres://identity_app:CHANGEME@localhost:5432/identity_control_dev?sslmode=disable

# Keycloak. scripts/dev-keycloak.ps1 builds the realm shape STD-IAM-002 requires; it needs a
# Keycloak on this address, which means Docker or a local distribution.
IDENTITY_KEYCLOAK_BASE_URL=http://127.0.0.1:8081
IDENTITY_KEYCLOAK_REALM=scnehaux
IDENTITY_KEYCLOAK_CLIENT_ID=identity-control
# Never committed. Printed by scripts/dev-keycloak.ps1 when it creates the client.
IDENTITY_KEYCLOAK_CLIENT_SECRET=

IDENTITY_TOKEN_ISSUER=http://127.0.0.1:8081/realms/scnehaux
IDENTITY_TOKEN_AUDIENCE=identity-control
IDENTITY_JWKS_URL=http://127.0.0.1:8081/realms/scnehaux/protocol/openid-connect/certs

IDENTITY_LISTEN_ADDRESS=127.0.0.1:8097

# Optional. Defaults live in internal/config/config.go; listed so the knobs are discoverable.
# IDENTITY_TOKEN_MAX_SKEW=30s
# IDENTITY_PROVISION_TIMEOUT=30m
# IDENTITY_PENDING_RECOVERY_AFTER=15m
# IDENTITY_RECONCILE_PAGE_SIZE=100

# Keeps the Go build cache off a full C: drive.
GOTMPDIR=D:\Ansha\.gotmp
